---
import styles from './Hero.module.css';
---

<section class={styles.hero} aria-labelledby="hero-title">
  <div class={styles.background} aria-hidden="true">
    <div class={styles.grain}></div>
  </div>

  <div class={styles.inner}>
    <div class={styles.content}>
      <h1 id="hero-title" class={styles.title}>
        Vestí tu <span class={styles.titleAccent}>pasión</span>.
      </h1>
      <p class={styles.subtitle}>
        Tu colección de camisetas empieza acá. Diseños exclusivos, telas importadas y envíos a todo el país.
      </p>
      <div class={styles.actions}>
        <a href="/productos" class={`${styles.cta} ${styles.ctaPrimary}`}>
          Ver camisetas
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12" />
            <polyline points="12 5 19 12 12 19" />
          </svg>
        </a>
      </div>
    </div>

    <div class={styles.metaRow} aria-hidden="true">
      <div class={styles.metaItem}>
        <span class={styles.metaLabel}>Diseños exclusivos</span>
      </div>
      <div class={styles.metaDivider}></div>
      <div class={styles.metaItem}>
        <span class={styles.metaLabel}>Envíos a todo el país</span>
      </div>
      <div class={styles.metaDivider}></div>
      <div class={styles.metaItem}>
        <span class={styles.metaNumber}>24/7</span>
        <span class={styles.metaLabel}>Atención WA</span>
      </div>
    </div>
  </div>

  <div class={styles.scrollHint} aria-hidden="true">
    <span class={styles.scrollText}>Scroll</span>
    <span class={styles.scrollLine}></span>
  </div>
</section>
