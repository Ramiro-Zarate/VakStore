---
import styles from './Nav.module.css';
import CartButton from './CartButton.tsx';
import AuthNav from './AuthNav.tsx';
import MobileMenu from './MobileMenu.tsx';

const pathname = Astro.url.pathname;
const isCurrent = (href: string) => {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href.split('?')[0]);
};

const links = [
  { href: '/', label: 'Inicio' },
  { href: '/productos', label: 'Productos' },
  { href: '/productos?sale=true', label: 'Ofertas' },
  { href: '/cuenta#contacto', label: 'Contacto' }
];
---

<header class={styles.header}>
  <div class={styles.inner}>
    <a href="/" class={styles.logo} aria-label="Vak Store - Ir al inicio">VakStore</a>

    <nav class={styles.primaryNav} aria-label="Principal">
      <ul class={styles.navList}>
        {links.map(link => (
          <li>
            <a
              href={link.href}
              class={styles.navLink}
              aria-current={isCurrent(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class={styles.actions}>
      <AuthNav client:load />
      <CartButton client:load />
      <MobileMenu client:load />
    </div>
  </div>
</header>
