---
import styles from './Nav.module.css';
import CartIsland from './CartIsland.tsx';
import AuthNav from './AuthNav.tsx';
import MobileMenu from './MobileMenu.tsx';

const pathname = Astro.url.pathname;
const isCurrent = (href: string) => {
  if (href === '/') return pathname === '/';

  const [pathWithHash, query] = href.split('?');
  const [path] = pathWithHash.split('#');

  if (!pathname.startsWith(path)) return false;

  if (query) {
    const linkParams = new URLSearchParams(query);
    const currentParams = Astro.url.searchParams;
    for (const [key, value] of linkParams) {
      if (currentParams.get(key) !== value) return false;
    }
  }

  return true;
};

const links = [
  { href: '/', label: 'Inicio' },
  { href: '/productos', label: 'Productos' },
  { href: '/productos?sale=true', label: 'Ofertas' },
  { href: '/cuenta#contacto', label: 'Contacto' }
];
---

<header class={styles.header}>
  <div class={styles.inner}>
    <a href="/" class={styles.logo} aria-label="Vak Store - Ir al inicio">VakStore</a>

    <nav class={styles.primaryNav} aria-label="Principal">
      <ul class={styles.navList}>
        {links.map(link => (
          <li>
            <a
              href={link.href}
              class={styles.navLink}
              aria-current={isCurrent(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class={styles.actions}>
      <AuthNav client:load />
      <CartIsland client:load />
      <MobileMenu client:load />
    </div>
  </div>
</header>
