---
export const prerender = false

import Layout from '../layouts/Layout.astro'

const whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '+5491100000000'
const whatsappDigits = whatsappNumber.replace(/[^\d]/g, '')
const email = 'vakindumentaria@gmail.com'
const instagramHandle = 'vak.storee'
const instagramUrl = 'https://instagram.com/vak.storee/'
const facebookUrl = 'https://facebook.com/'
---

<Layout
  title="Contacto | Vak Store"
  description="Ponete en contacto con Vak Store por WhatsApp, email, Instagram o Facebook."
>
  <article class="contact">
    <header class="header">
      <p class="eyebrow">— Contacto</p>
      <h1 class="title">Ponete en contacto con nosotros</h1>
      <p class="subtitle">Elegí el canal que prefieras, te respondemos rápido.</p>
    </header>

    <div class="grid">
      <a
        class="card"
        href={`https://wa.me/${whatsappDigits}`}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="icon" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            width="32"
            height="32"
            fill="currentColor"
            stroke="none"
          >
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
          </svg>
        </span>
        <h2 class="card-title">WhatsApp</h2>
        <p class="card-detail">{whatsappNumber}</p>
        <p class="card-meta">Respuesta en el día</p>
        <span class="card-cta">Enviar mensaje →</span>
      </a>

      <a class="card" href={`mailto:${email}`}>
        <span class="icon" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            width="32"
            height="32"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <polyline points="3 7 12 13 21 7" />
          </svg>
        </span>
        <h2 class="card-title">Email</h2>
        <p class="card-detail">{email}</p>
        <p class="card-meta">Te respondemos en 24-48hs</p>
        <span class="card-cta">Escribir email →</span>
      </a>

      <a
        class="card"
        href={instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="icon" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            width="32"
            height="32"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none" />
          </svg>
        </span>
        <h2 class="card-title">Instagram</h2>
        <p class="card-detail">
          <span class="at-prefix">@</span>{instagramHandle}
        </p>
        <p class="card-meta">Seguinos para ver novedades</p>
        <span class="card-cta">Abrir Instagram →</span>
      </a>
    </div>
  </article>
</Layout>

<style>
  .contact {
    max-width: 960px;
    margin: 0 auto;
    padding: var(--space-7) var(--space-5);
  }

  .header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-7);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--color-border);
    text-align: center;
    align-items: center;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--color-accent);
    margin: 0;
  }

  .title {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: var(--weight-bold);
    line-height: var(--leading-none);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text-primary);
    margin: 0;
  }

  @media (max-width: 640px) {
    .title {
      font-size: var(--text-3xl);
    }
  }

  .subtitle {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin: var(--space-2) 0 0;
    max-width: 560px;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  @media (max-width: 720px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  .card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-3);
    padding: var(--space-6) var(--space-5);
    background-color: var(--color-bg-elev-1);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .card:hover {
    border-color: var(--color-accent);
    background-color: var(--color-bg-elev-2);
    transform: translateY(-2px);
  }

  .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-pill);
    background-color: var(--color-accent-soft);
    color: var(--color-accent);
  }

  .card-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--color-text-primary);
    margin: 0;
  }

  .card-detail {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-primary);
    margin: 0;
    word-break: break-all;
  }

  .at-prefix {
    font-family: var(--font-body);
    font-weight: var(--weight-bold);
    color: var(--color-accent);
    margin-right: 1px;
  }

  .card-meta {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-snug);
    margin: 0;
  }

  .card-cta {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--color-accent);
    margin-top: var(--space-2);
  }
</style>
