---
export const prerender = false
import '../pages/styles/global.css'
import Layout from '../layouts/Layout.astro'
import FilterSidebar from '../components/FilterSidebar.tsx'
import ProductGrid from '../components/ProductGrid.tsx'
import { getLeagues } from '../lib/leagues'

const { searchParams } = Astro.url
const leagues = await getLeagues()
const q = searchParams.get('q') ?? undefined

const filters = {
  category: searchParams.get('category') || undefined,
  size: searchParams.get('size') || undefined,
  league: searchParams.get('league') || undefined,
  minPrice: searchParams.get('minPrice') || undefined,
  maxPrice: searchParams.get('maxPrice') || undefined
}

const hasFilters = Object.values(filters).some(Boolean)
const titlePrefix = hasFilters ? 'Resultados' : 'Todos los productos'
---

<Layout title={`${titlePrefix} | Vak Store`} description="Explorá nuestra colección completa de camisetas de fútbol importadas. Filtrá por liga, talle y precio." noindex={Boolean(q || hasFilters)}>
  <div class="productos-page">
    <FilterSidebar client:visible leagues={leagues} />

    <section class="content" aria-labelledby="productos-title">
      <header class="content-header">
        <p class="eyebrow">— Catálogo</p>
        <h1 id="productos-title" class="page-title">Productos</h1>
        <p class="page-subtitle">Encontrá tu próxima camiseta. Filtrá por liga, talle o precio.</p>
      </header>
      <ProductGrid client:visible q={q} />
    </section>
  </div>
</Layout>

<style>
  .productos-page {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: var(--space-6);
    padding: var(--space-7) var(--space-5);
    max-width: var(--container-max);
    margin: 0 auto;
    align-items: start;
  }

  .content {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .content-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--color-accent);
    margin: 0;
  }

  .page-title {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: var(--weight-bold);
    line-height: var(--leading-none);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text-primary);
    margin: 0;
  }

  .page-subtitle {
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 560px;
  }

  @media (max-width: 1024px) {
    .productos-page {
      grid-template-columns: 1fr;
      padding: var(--space-5);
      gap: var(--space-5);
    }

    .page-title {
      font-size: var(--text-3xl);
    }
  }
</style>
